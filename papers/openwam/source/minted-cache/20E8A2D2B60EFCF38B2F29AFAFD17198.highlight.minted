\begin{MintedVerbatim}[commandchars=\\\{\}]
\PYG{n}{avg\PYGZus{}accel}   \PYG{o}{=} \PYG{n+nb}{sum}\PYG{p}{(}\PYG{n}{accels}\PYG{p}{)} \PYG{o}{/} \PYG{n+nb}{len}\PYG{p}{(}\PYG{n}{accels}\PYG{p}{)}
