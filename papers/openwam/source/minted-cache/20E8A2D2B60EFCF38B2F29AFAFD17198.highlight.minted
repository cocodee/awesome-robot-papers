\PYG{k}{else}\PYG{p}{:}
    \PYG{n}{max\PYGZus{}rel\PYGZus{}dev\PYGZus{}a} \PYG{o}{=} \PYG{l+m+mf}{0.0}

\PYG{k}{if} \PYG{n+nb}{abs}\PYG{p}{(}\PYG{n}{avg\PYGZus{}accel}\PYG{p}{)} \PYG{o}{\PYGZlt{}}\PYG{o}{=} \PYG{n}{MIN\PYGZus{}ABS\PYGZus{}ACCEL}\PYG{p}{:}
    \PYG{c+c1}{\PYGZsh{} acceleration is very small \PYGZhy{}\PYGZgt{} closer to uniform speed / almost static}
    \PYG{o}{.}\PYG{o}{.}\PYG{o}{.}
\PYG{k}{else}\PYG{p}{:}
