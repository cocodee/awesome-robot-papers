\PYG{k}{if} \PYG{n+nb}{abs}\PYG{p}{(}\PYG{n}{avg\PYGZus{}accel}\PYG{p}{)} \PYG{o}{\PYGZgt{}} \PYG{n}{MIN\PYGZus{}ABS\PYGZus{}ACCEL}\PYG{p}{:}
